# admin-server 环境变量示例（复制为 .env 或直接 export）

# 主密钥（AES-256-GCM 加密私钥用）。
# 必须是 32 字节随机密钥（64 位 hex）。这不是密码，不能用人类口令。
# 生成命令（CSPRNG）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 注意：这是 master-key 存储格式 cutover；旧版“任意口令→SHA256”派生规则已移除，
#       升级前请删除旧开发测试数据（keys.json），并重新生成随机主密钥。
# 也可改用 MASTER_KEY_FILE 指向密钥文件，或直接放 admin-server/master.key（已 gitignore）。
MASTER_KEY=

# 监听地址/端口
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8788

# CORS 白名单（逗号分隔，禁止 *）
ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://127.0.0.1:5173

# 可信反向代理来源（逗号分隔；仅这些来源的 X-Forwarded-For 会被信任）
ADMIN_TRUSTED_PROXIES=127.0.0.1,::1,::ffff:127.0.0.1

# 接口限流：每 IP 每分钟最大请求数
ADMIN_RATE_LIMIT=10

# 数据文件目录（可选，默认 admin-server/ 下）
# ADMIN_DATA_DIR=/var/lib/bnbchange-admin
